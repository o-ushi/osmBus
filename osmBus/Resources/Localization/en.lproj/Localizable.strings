// MARK: - Help rows (symbolic keys)
"help.basic.add.title" = "Add a Spot";
"help.basic.add.body" = "Tap the '+' button at the top-right of the list to open the scene picker. Choose from four options: 'Record Current Location', 'Save a Place to Visit', 'Save as Draft', or 'Register from Photo'.";
"help.basic.record_now.title" = "Record Current Location Instantly";
"help.basic.record_now.body" = "Tap '+' → 'Record Current Location' to open the add screen with your current GPS coordinates pre-filled. Just enter a name and tap 'Save' to quickly capture where you are.";
"help.basic.want_to_go_map.title" = "Add by Long-Pressing the Map";
"help.basic.want_to_go_map.body" = "Tap '+' → 'Save a Place to Visit' → 'Pick from Map' to open a map. Long-press your target location to drop a pin, then tap 'Confirm Location' to open the add screen with coordinates pre-filled.";
"help.basic.edit.title" = "Edit a Spot";
"help.basic.edit.body" = "Tap a row in the list to open the detail screen, then tap the 'Edit' button in the top-right.";
"help.basic.delete.title" = "Delete a Spot";
"help.basic.delete.body" = "Swipe left on a row in the list to reveal the 'Delete' button.";
"help.basic.search.title" = "Search Spots";
"help.basic.search.body" = "Pull down on the list screen to reveal the search bar. It searches across title, event name, memo, and category.";
"help.bulk.multiDelete.title" = "Select and Delete Multiple";
"help.bulk.multiDelete.body" = "Go to '…' → 'Select' to enter selection mode and tap rows to delete. Use 'Select All' then the trash icon to bulk-delete after confirmation.";
"help.bulk.share.title" = "Send Multiple to Another Device";
"help.bulk.share.body" = "In selection mode, select rows and tap the share button (↑) in the toolbar. Choose AirDrop or another destination. The recipient can import data via '…' → 'Import'.";
"help.detail.inline.title" = "Inline Editing on Detail Screen";
"help.detail.inline.body" = "Long-press any field (name, event, category, date, rating, memo) on the detail screen to edit it in place. Tap 'Save' to confirm or 'Cancel' to discard.";
"help.detail.go.title" = "Go — Google Maps";
"help.detail.go.body" = "For spots with coordinates, a 'Go' button appears at the top-right of the detail screen. Choose a starting point to open directions in the Google Maps app. Switch driving, walking, transit, and more in Maps. If the app isn't installed, the browser opens instead. You can also open the same place via 'Open in Google Maps' on the detail and list screens.";
"help.detail.mapJump.title" = "Jump to Map from Detail";
"help.detail.mapJump.body" = "The hero image at the top of the detail screen is a map snapshot. Tap 'View Location' in the Position section to switch to the map tab and center on that spot.";
"help.filter.filter.title" = "Filter";
"help.filter.filter.body" = "Tap the filter icon at the top of the list to filter by category and rating, and by month (grouped by year) or date range using either the visit date or the registration date. The icon appears filled when a filter is active.";
"help.filter.sort.title" = "Sort";
"help.filter.sort.body" = "Use the sort icon to switch ascending/descending order for 'Place Name', 'Event', 'Visit Date', or 'Distance'. Distance sort requires location permission.";
"help.photo.add.title" = "Add or Change a Photo";
"help.photo.add.body" = "In the add/edit screen's Photo section, tap 'Add Photo' to choose from your camera roll. Photos are resized to 1200px max on save. Tap 'Delete Photo' to remove.";
"help.photo.display.title" = "Photos & Maps in List & Detail";
"help.photo.display.body" = "Only photos you add appear as thumbnails; otherwise a light frame is shown (text on the right stays aligned). The top of detail is map-only. If you added a photo, it appears at the bottom (below \"Search with Google AI\").";
"help.photo.exif.title" = "Auto-import location & visit date from photo";
"help.photo.exif.body" = "When you pick a photo from your camera roll in the add/edit screen, GPS coordinates are auto-filled if the photo contains location data. The shooting date/time is also applied to the visit date if available. A message is shown if neither is found.";
"help.quickShoot.shoot.title" = "Record instantly with Quick Shoot";
"help.quickShoot.shoot.body" = "Tap the Shoot button in the center of the tab bar to launch the camera. After taking a shot, the photo and location (GPS or current position) are automatically saved as a draft. Perfect for quick captures on the go.";
"help.quickShoot.draft.title" = "Finish drafts later";
"help.quickShoot.draft.body" = "Drafts appear at the top of the list with an orange Draft badge. Tap one to open the edit screen, add a title and category, then tap Publish to save it as a full record. You can also delete a draft by swiping left.";
"help.memo.view.title" = "View Memo (from List)";
"help.memo.view.body" = "Spots with a memo show '📝' at the end of the row. Tap it to view the memo in a popup.";
"help.memo.edit.title" = "Edit Memo (Detail Screen)";
"help.memo.edit.body" = "Long-press the Memo field on the detail screen to enter edit mode. Tap 'Save' after typing.";
"help.mapLink.import.title" = "Import a Map Share Link";
"help.mapLink.import.body" = "Open a place in Google Maps, then Share → Copy Link. Paste it into the 'Map share link' field in add/edit to auto-fill coordinates (supports Google Maps links such as maps.app.goo.gl and other common formats).";
"help.mapLink.open.title" = "Open Google Maps from the App";
"help.mapLink.open.body" = "Enter the place name in add/edit, then tap 'Open in Google Maps by Name'. Find the place, Share → Copy Link, return to the app, and the link is applied automatically.";
"help.mapLink.slow.title" = "If Link Import Takes Too Long";
"help.mapLink.slow.body" = "Short links (maps.app.goo.gl) need to be expanded over the network, which may take a few seconds. A Places API key improves reliability.";
"help.mapLink.list.title" = "Import a Saved List from a Map Service";
"help.mapLink.list.body" = "From the list, use '…' → 'Import map link list' and paste a share URL, copied list text, or Google Takeout Saved Places JSON/CSV (may include data from Google Maps). The list name is saved as the event name in osmStroll.";
"help.mapLink.export.title" = "Export a Google Maps Link List";
"help.mapLink.export.body" = "Choose '…' → 'Export' → 'Google Maps link list (TXT)' to export google.com/maps search URLs for your spots. Follow each service's steps when copying into another app's list.";
"help.mapTab.tab.title" = "Map Tab";
"help.mapTab.tab.body" = "The Map tab at the bottom shows all registered spots as pins. Tap a pin to go to the detail screen.";
"help.mapTab.switch.title" = "Switch to Map Tab from Detail";
"help.mapTab.switch.body" = "Tap 'View Location' in the Position section of the detail screen to switch to the map tab and center on that spot.";
"help.appearance.theme.title" = "Color Theme";
"help.appearance.theme.body" = "Go to Settings → Color Theme to choose from 4 color schemes: Standard, Chic, Pop, and Monochrome. The accent, star, and map pin colors all change together.";
"help.appearance.style.title" = "Style, Texture & Background";
"help.appearance.style.body" = "Go to Settings → Appearance to customize card style (Pastel, Neon, etc.), background texture (Grid, Dot, etc.), and app background color. Custom colors and styles are also available.";
"help.data.backup.title" = "Back Up Your Data";
"help.data.backup.body" = "Go to '…' → 'Export' to save all spots as a JSON file. Storing it in iCloud Drive or Files is recommended.";
"help.data.restore.title" = "Restore or Transfer Data";
"help.data.restore.body" = "Go to '…' → 'Import' to load an exported JSON/ZIP file. If you choose text or CSV/JSON containing map share URLs, osmStroll tries to import it as a link list.";
"help.plan.upgrade.title" = "View Plan & Upgrade";
"help.plan.upgrade.body" = "Tap '…' → 'Plan' to view your current plan or upgrade. The FREE plan allows up to 10 spots. Upgrade to PREMIUM for unlimited spots and a different app icon.";
"help.plan.restore.title" = "Restore a Purchase";
"help.plan.restore.body" = "After switching devices or reinstalling, tap '…' → 'Plan' → 'Restore Purchases'. If you previously bought PREMIUM with the same Apple ID, it will be restored.";
"help.settings.language.title" = "Change Language";
"help.settings.language.body" = "Go to Settings → Language to switch between Japanese, English, and Vietnamese.";
"help.settings.categories.title" = "Manage Categories";
"help.settings.categories.body" = "Go to Settings → Categories to add, delete, reorder, or change icons. To reorder, tap 'Edit' and drag the rows.";
"help.apiKey.places.title" = "About the Places API Key";
"help.apiKey.places.body" = "Registering a 'Places API (New)' key from Google Cloud Console improves coordinate parsing from shared links. Many links work without a key, but a key reduces failures.";


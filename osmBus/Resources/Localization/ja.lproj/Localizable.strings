// MARK: - Help rows (symbolic keys)
"help.basic.add.title" = "スポットを追加";
"help.basic.add.body" = "一覧画面右上の「＋」ボタンをタップすると、登録方法の選択画面が開きます。「今いる場所を記録する」「行きたい場所を登録する」「あとで編集（下書き）」「写真から登録する」の4種類から選んでください。";
"help.basic.record_now.title" = "今いる場所をすぐ記録";
"help.basic.record_now.body" = "「＋」→「今いる場所を記録する」をタップすると、現在地の緯度・経度が自動入力された状態で登録画面が開きます。店名を入力して「保存」するだけで、いまいる場所をすばやく記録できます。";
"help.basic.want_to_go_map.title" = "地図を長押しして登録";
"help.basic.want_to_go_map.body" = "「＋」→「行きたい場所を登録する」→「地図から選ぶ」をタップすると地図が開きます。登録したい場所を長押しするとピンが立ち、「この場所で決定」をタップすると緯度・経度が入力済みの状態で登録画面が開きます。";
"help.basic.edit.title" = "スポットを編集";
"help.basic.edit.body" = "一覧から行をタップして詳細画面を開き、右上の「編集」ボタンをタップします。";
"help.basic.delete.title" = "スポットを削除（1件）";
"help.basic.delete.body" = "一覧画面で行を左にスワイプすると「削除」ボタンが現れます。";
"help.basic.search.title" = "スポットを検索";
"help.basic.search.body" = "一覧画面を下にスワイプすると検索バーが表示されます。タイトル・イベント名・メモ・カテゴリを横断して絞り込みます。";
"help.bulk.multiDelete.title" = "複数件を選択して削除";
"help.bulk.multiDelete.body" = "「…」→「選択」で選択モードに入り、削除したい行をタップします。「全選択」で全件選択、ゴミ箱ボタンで確認後に一括削除できます。";
"help.bulk.share.title" = "複数件を別の端末へ送る";
"help.bulk.share.body" = "選択モードで送りたい行を選び、ツールバーの共有ボタン（↑マーク）をタップします。AirDrop または各種共有先を選んでください。受け取り側は「…」→「インポート」でデータを取り込めます。";
"help.detail.inline.title" = "詳細画面でインライン編集";
"help.detail.inline.body" = "詳細画面の各項目（店名・イベント・カテゴリ・訪問日時・おすすめ・メモ）を長押しすると、その場で編集できます。「保存」で確定、「キャンセル」で破棄します。";
"help.detail.go.title" = "Go ボタン — Google マップへ";
"help.detail.go.body" = "緯度・経度が登録されているスポットでは、詳細画面右上に「Go」ボタンが表示されます。出発地を選び、「Google マップでルートを開く」から Google マップアプリの経路画面を開けます。車・徒歩・公共交通などはマップ側で切り替えられます。アプリが入っていない場合はブラウザの Google マップに切り替わります。詳細・一覧の「Google マップで開く」からも同じ場所を Google マップで確認できます。";
"help.detail.mapJump.title" = "詳細画面から地図タブへジャンプ";
"help.detail.mapJump.body" = "詳細画面上部のヒーロー画像は地図スナップショットになっています。「位置」セクションの「場所を確認する」をタップすると、地図タブへ切り替わりそのスポットを中心に表示します。";
"help.filter.filter.title" = "フィルター";
"help.filter.filter.body" = "一覧上部のフィルターアイコンをタップすると、カテゴリ・おすすめ度に加え、訪問日または登録日を基準に月（年ごとに折り畳み）や期間で絞り込めます。フィルターが有効なときはアイコンが塗りつぶし表示になります。";
"help.filter.sort.title" = "並び替え";
"help.filter.sort.body" = "並び替えアイコンから「店名」「イベント」「訪問日時」「現在地からの距離」で昇順／降順を切り替えられます。距離ソートは位置情報の許可が必要です。";
"help.photo.add.title" = "写真を追加・変更する";
"help.photo.add.body" = "追加・編集画面の「写真」セクションで「写真を追加」をタップし、カメラロールから選べます。保存時に最大 1200px にリサイズされ、容量を抑えて保存されます。「写真を削除」で削除できます。";
"help.photo.display.title" = "一覧・詳細の写真と地図";
"help.photo.display.body" = "一覧では自分が登録した写真のみがサムネイルになり、写真がないときは薄い枠が表示されます（右側のテキストの位置は変わりません）。詳細の一番上は地図のみです。写真を登録しているときは、画面下部（「Google AIで調べる」の下）に表示されます。";
"help.photo.exif.title" = "写真から位置・訪問日を自動取り込み";
"help.photo.exif.body" = "追加・編集画面でカメラロールから写真を選ぶと、写真に GPS 情報が記録されていれば緯度・経度が自動で入力されます。撮影日時が記録されていれば訪問日時も自動で反映されます。どちらも含まれない場合はメッセージが表示されます。";
"help.quickShoot.shoot.title" = "クイック撮影で素早く記録する";
"help.quickShoot.shoot.body" = "タブバー中央の「撮影」ボタンをタップするとカメラが起動します。シャッターを切ると、写真と位置情報（GPS または現在地）が自動で下書きとして保存されます。移動中に素早く記録したいときに便利です。";
"help.quickShoot.draft.title" = "下書きをあとから仕上げる";
"help.quickShoot.draft.body" = "下書きは一覧画面の先頭にオレンジの「下書き」バッジ付きで表示されます。タップして編集画面を開き、タイトル・カテゴリなどを追加して「本保存」をタップすると正式な記録になります。下書きのまま左スワイプで削除することもできます。";
"help.memo.view.title" = "メモを確認する（一覧から）";
"help.memo.view.body" = "メモが入力済みのスポットには行末に「📝」が表示されます。タップするとポップアップで内容を確認できます。";
"help.memo.edit.title" = "メモを編集する（詳細画面）";
"help.memo.edit.body" = "詳細画面の「メモ」欄を長押しすると編集モードになります。入力後「保存」をタップしてください。";
"help.mapLink.import.title" = "地図の共有リンクを取り込む";
"help.mapLink.import.body" = "Google マップで場所を開き「共有」→「リンクをコピー」でリンクをコピーします。追加・編集画面の「地図の共有リンク」欄に貼り付けると、緯度・経度が自動で反映されます（maps.app.goo.gl など Google マップのリンクをはじめ、主要な形式に対応）。";
"help.mapLink.open.title" = "アプリ内から Google マップを開く";
"help.mapLink.open.body" = "追加・編集画面で店名を入力後、「店名・場所で Google マップを開く」ボタンをタップします。Google マップで場所を確認し「共有」→「リンクをコピー」でコピーしてアプリに戻ると、リンクが自動で反映されます。";
"help.mapLink.slow.title" = "リンクの取り込みに時間がかかる場合";
"help.mapLink.slow.body" = "短縮リンク（maps.app.goo.gl）は通信で展開する必要があります。展開には数秒かかることがあります。Places API キーが設定されていると、より確実に取り込めます。";
"help.mapLink.list.title" = "地図サービスの保存リストを取り込む";
"help.mapLink.list.body" = "一覧の「…」→「地図リンクリストを取り込む」で、共有 URL、コピーしたリスト本文、または Google Takeout の Saved Places JSON/CSV を貼り付けます（Google マップ由来のデータを含みます）。リスト名を入れると osmStroll のイベント名として保存されます。";
"help.mapLink.export.title" = "Google マップ用リンク一覧を書き出す";
"help.mapLink.export.body" = "「…」→「エクスポート」から「Google マップ用リンク一覧（TXT）」を選ぶと、登録スポットの Google マップ向け検索 URL（google.com の地図）の一覧を書き出せます。別サービスのリストへ反映するときは各アプリの手順に従ってください。";
"help.mapTab.tab.title" = "地図タブ";
"help.mapTab.tab.body" = "画面下部の「地図」タブでは、登録したスポットをマップ上のピンで一覧できます。ピンをタップすると詳細画面へ移動します。";
"help.mapTab.switch.title" = "詳細から地図タブへ切り替える";
"help.mapTab.switch.body" = "詳細画面の「位置」セクションで「場所を確認する」をタップすると、地図タブへ自動で切り替わり、そのスポットを地図の中心に表示します。";
"help.appearance.theme.title" = "カラーテーマ";
"help.appearance.theme.body" = "「設定」→「カラーテーマ」で「標準」「シック」「ポップ」「モノクロ」の4種類から配色を選べます。アクセントカラー・星色・地図ピン色がまとめて切り替わります。";
"help.appearance.style.title" = "外観（枠・テクスチャ・背景色）";
"help.appearance.style.body" = "「設定」→「見た目」→「外観」でスポットカードの枠スタイル（パステル・ネオンなど）、背景のテクスチャ（方眼・ドットなど）、アプリ背景色をカスタマイズできます。カスタムカラーや独自の枠スタイルも設定可能です。";
"help.data.backup.title" = "データをバックアップする";
"help.data.backup.body" = "「…」→「エクスポート」で全スポットを JSON ファイルに書き出せます。iCloud Drive や Files アプリに保存しておくと安心です。";
"help.data.restore.title" = "データを復元・引き継ぎする";
"help.data.restore.body" = "「…」→「インポート」でエクスポートした JSON/ZIP ファイルを読み込めます。地図の共有 URL を含むテキストや CSV/JSON を選んだ場合は、リンクリストとして取り込みを試します。";
"help.plan.upgrade.title" = "プランを確認・アップグレードする";
"help.plan.upgrade.body" = "「…」→「プラン管理」でプランの確認とアップグレードができます。FREE プランでは最大 10 件のスポットを登録できます。PREMIUM プランにアップグレードすると無制限になり、アプリアイコンが変わります。";
"help.plan.restore.title" = "購入を復元する";
"help.plan.restore.body" = "機種変更や再インストール後は「…」→「プラン管理」→「購入を復元」をタップしてください。同じ Apple ID で購入済みの場合、PREMIUM プランが復元されます。";
"help.settings.language.title" = "言語を変更する";
"help.settings.language.body" = "「設定」→「言語」で「日本語」「English」「Tiếng Việt」に切り替えられます。";
"help.settings.categories.title" = "カテゴリを管理する";
"help.settings.categories.body" = "「設定」→「カテゴリ一覧」でカテゴリの追加・削除・並び替え・アイコン変更ができます。並び替えは「編集」ボタンを押してから行をドラッグしてください。";
"help.apiKey.places.title" = "Places API キーについて";
"help.apiKey.places.body" = "Google Cloud Console で発行した「Places API（新）」のキーを登録すると、写真の取得精度と共有リンクからの座標解析精度が向上します。キーなしでも地図スナップショットは表示されます。";


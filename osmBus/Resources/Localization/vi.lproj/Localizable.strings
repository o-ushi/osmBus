"help_目的地_title" = "Đặt điểm đến";

"help_目的地_body" = "Chạm thanh điểm đến để chọn từ tìm kiếm, lịch sử hoặc địa điểm đã lưu. Cũng có thể chọn trên bản đồ bằng biểu tượng bản đồ. Lịch sử và địa điểm đã lưu nằm trong sheet điểm đến.";

"help_現在地_title" = "Lấy vị trí hiện tại";


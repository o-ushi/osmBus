"help_バス番号_title" = "Nhập số xe buýt";

"help_バス番号_body" = "Chỉ khi số không có trên bảng, mở … → Nhập số (hoặc vuốt từ mép trái) rồi chỉ nhập số (vd: 35). Ứng dụng đối chiếu tuyến; nếu xe tới điểm trung chuyển thì vẫn có thể lên xe.";

"help_APIキー_とは_title" = "Khóa API là gì?";

"help_APIキー_とは_body" = "Giống mật khẩu để ứng dụng hỏi Google về tuyến xe buýt. osmBus chỉ dùng cho việc này. Có thể cài đặt với gói PREMIUM — với khóa riêng, kiểm tra không giới hạn và không tính vào hạn mức miễn phí hàng tháng.";

"help_APIキー_設定_title" = "Cách cài đặt";

"help_APIキー_設定_body" = "Mở … → Cài đặt → Google API và làm theo hướng dẫn trên màn hình để tạo khóa trên Google Cloud Console, dán và lưu. Có thể chạy Kiểm tra kết nối. Lưu khóa cần PREMIUM.";

"help_APIキー_安心_title" = "Khóa có an toàn không?";

"help_APIキー_安心_body" = "Khóa được lưu trong Keychain và gửi cho Google để xác thực API. Khóa không được gửi đến máy chủ riêng của nhà phát triển.";

"help_乗車_title" = "Bắt đầu đi";

"help_乗車_body" = "Trên Nhập số, khi tuyến bạn nhập khớp rõ ràng với điểm đến (khớp chính xác, hoặc mọi biến thể như cả 35A và 35B), nút màu xanh \"Bắt đầu đi\" sẽ hiện ra — chính nút đó là dấu hiệu bạn có thể lên xe. Nếu chỉ một số biến thể đi được, thông báo màu vàng như \"Nếu là 35A thì lên xe!\" sẽ xuất hiện, và bạn vẫn có thể chạm Bắt đầu đi cho biến thể đó.";

"help_不可_title" = "Bỏ qua xe này!";

"help_不可_body" = "Không có biến thể phù hợp trên tuyến đến điểm đến — màn hình hiển thị đỏ \"Bỏ qua xe này!\". Nếu xe vẫn tới điểm trung chuyển trên gợi ý của Google, nhập số trên bàn phím vẫn có thể được lên xe.";

"help_ルートなし_title" = "Không tìm thấy tuyến";


"help_お試し_title" = "Lượt dùng miễn phí hàng tháng";
"help_お試し_body" = "Không cần khóa riêng: gói FREE được 30 lần kiểm tra/tháng (khóa dùng chung). Gói PREMIUM được 60 lần/tháng. Đặt lại ngày 1 hàng tháng. Số lần còn lại hiện dưới bảng số xe trên Ma trận (hoặc cuối Nhập số). Cài khóa riêng (PREMIUM) để dùng không giới hạn.";
"help_トップ_title" = "Ma trận";
"help_トップ_body" = "Đây là màn hình khi mở ứng dụng: điểm đến, vị trí, khoảng cách và bảng số xe. Để kiểm tra số trên bàn phím, mở … → Nhập số. Cũng có thể vuốt sang phải từ mép trái. Quay lại bằng … → Ma trận, hoặc vuốt từ mép trái lần nữa.";
"help_距離_title" = "Màu khoảng cách";
"help_距離_body" = "Khi chưa lên xe, huy hiệu là khoảng cách thẳng đến điểm đến. Khi đang đi, là khoảng cách đến trạm xuống của xe hiện tại. Từ 3 km xanh dương, từ 1 km xanh lá, từ 500 m vàng, từ 200 m cam, dưới 200 m đỏ. Khi đang đi, chạm huy hiệu để mở bản đồ tuyến (chưa lên xe thì chỉ hiển thị). Giữ huy hiệu để hủy điều hướng (cũng xóa điểm đến). Để xuống xe chuyển tuyến, giữ số xe trên bảng.";
"help_バス番号表_title" = "Bảng số xe buýt";
"help_バス番号表_body" = "Số xe được nhóm theo hướng và số lần chuyển. Chạm để mở bản đồ tuyến, giữ để lên hoặc xuống xe. Xe đang đi được tô nổi.";
"help_経路_title" = "Tuyến đi";
"help_経路_body" = "Chạm số xe trên bảng để mở bản đồ tuyến Google tương ứng. Giữ số xe để lên hoặc xuống.";
"help_路線図_title" = "Sơ đồ tuyến (OSM)";
"help_路線図_body" = "Khi chưa lên xe, … → Sơ đồ tuyến mở bản đồ OpenStreetMap toàn tuyến — không phải chuyến Google. Nếu lên xe từ bản đồ OSM, lúc đang đi vẫn là OSM. Khi đang đi xe Google, Sơ đồ tuyến và huy hiệu khoảng cách đều mở bản đồ tuyến Google hiện tại.";
"help_乗車中_title" = "Chế độ đang đi";
"help_乗車中_body" = "Giữ số xe trên bảng để bắt đầu đi. Giữ cùng số lần nữa để xuống (chuyển tuyến), rồi giữ xe tiếp theo. Khi đang đi, khoảng cách là đường thẳng đến trạm xuống của xe hiện tại và đổi sau khi chuyển. Chạm huy hiệu khoảng cách và … → Sơ đồ tuyến mở cùng một bản đồ tuyến. Trên … → Nhập số có thể dùng Bắt đầu đi và Xuống xe trên thẻ.";
"help_設定_title" = "Cài đặt & cảnh báo";
"help_設定_body" = "Từ … → Cài đặt bạn có thể đổi ngôn ngữ, âm thanh bàn phím và cảnh báo đến nơi. Cảnh báo đến nơi dựa trên khoảng cách đến trạm xuống xe, hỗ trợ tối đa 3 mức — chuông reo 1–3 lần từ xa đến gần. Chuông và cảnh báo hoạt động ngay cả khi ứng dụng ở nền hoặc màn hình tắt. Khóa Google API (dùng chung Routes và bản đồ) cũng cài ở đây. Lưu khóa cần PREMIUM.";


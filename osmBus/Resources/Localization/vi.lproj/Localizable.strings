"help_お試し_title" = "Lượt dùng miễn phí hàng tháng";
"help_お試し_body" = "Không cần khóa riêng: gói FREE được 30 lần kiểm tra/tháng (khóa dùng chung). Gói PREMIUM được 60 lần/tháng. Đặt lại ngày 1 hàng tháng. Số lần còn lại hiện dưới bảng số xe trên màn hình tổng quan (hoặc cuối màn hình chính). Cài khóa riêng (PREMIUM) để dùng không giới hạn.";
"help_トップ_title" = "Màn hình tổng quan";
"help_トップ_body" = "Đây là màn hình khi mở ứng dụng: điểm đến, vị trí, khoảng cách và bảng số xe. Để kiểm tra số trên bàn phím, mở … → Màn hình chính. Quay lại bằng … → Màn hình tổng quan.";
"help_距離_title" = "Màu khoảng cách";
"help_距離_body" = "Thanh khoảng cách là đường thẳng đến điểm đến khi chưa lên xe, hoặc đến trạm xuống của xe hiện tại khi đang đi. Từ 3 km màu xanh dương, từ 1 km xanh lá, từ 500 m vàng, từ 200 m cam, dưới 200 m đỏ. Chạm thanh để mở bản đồ tuyến.";
"help_バス番号表_title" = "Bảng số xe buýt";
"help_バス番号表_body" = "Số xe được nhóm theo hướng và số lần chuyển. Chạm để mở bản đồ tuyến, giữ để lên hoặc xuống xe. Xe đang đi được tô nổi.";
"help_経路_title" = "Tuyến đi";
"help_経路_body" = "Chạm số xe trên màn hình tổng quan để mở bản đồ tuyến. Để xem danh sách đầy đủ, mở … → Màn hình chính rồi chạm Xem tuyến (hoặc lắc máy). Chạm một tuyến để xem bản đồ, hoặc giữ số xe để lên hoặc xuống.";
"help_乗車中_title" = "Chế độ đang đi";
"help_乗車中_body" = "Giữ số xe trên màn hình tổng quan để bắt đầu đi. Giữ cùng số lần nữa để xuống xe. Khi chuyển tuyến, giữ xe tiếp theo. Khoảng cách là đường thẳng đến trạm xuống của xe hiện tại và đổi sau khi chuyển. Chạm thanh khoảng cách để mở bản đồ tuyến. Trên … → Màn hình chính, sau kết quả xanh/vàng có thể chạm Bắt đầu đi, và dùng nút Xuống xe trên thẻ.";
"help_設定_title" = "Cài đặt & cảnh báo";
"help_設定_body" = "Từ … → Cài đặt bạn có thể đổi ngôn ngữ, âm thanh bàn phím và cảnh báo đến nơi. Cảnh báo đến nơi dựa trên khoảng cách đến trạm xuống xe, hỗ trợ tối đa 3 mức — chuông reo 1–3 lần từ xa đến gần. Chuông và cảnh báo hoạt động ngay cả khi ứng dụng ở nền hoặc màn hình tắt. Khóa Maps API và Routes API cũng cài ở đây (PREMIUM).";


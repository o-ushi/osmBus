// MARK: - Help rows (symbolic keys)
"help.basic.add.title" = "Thêm địa điểm";
"help.basic.add.body" = "Nhấn nút '+' ở góc trên bên phải danh sách để mở màn hình chọn cách thêm. Chọn trong bốn tùy chọn: 'Ghi lại vị trí hiện tại', 'Lưu nơi muốn đến', 'Lưu thành bản nháp' hoặc 'Đăng ký từ ảnh'.";
"help.basic.record_now.title" = "Ghi lại vị trí hiện tại ngay lập tức";
"help.basic.record_now.body" = "Nhấn '+' → 'Ghi lại vị trí hiện tại' để mở màn hình thêm với tọa độ GPS hiện tại đã được điền sẵn. Chỉ cần nhập tên và nhấn 'Lưu' để ghi lại nhanh nơi bạn đang đứng.";
"help.basic.want_to_go_map.title" = "Thêm bằng cách nhấn giữ bản đồ";
"help.basic.want_to_go_map.body" = "Nhấn '+' → 'Lưu nơi muốn đến' → 'Chọn từ bản đồ' để mở bản đồ. Nhấn giữ vị trí muốn thêm để đặt ghim, rồi nhấn 'Xác nhận vị trí' để mở màn hình thêm với tọa độ đã điền sẵn.";
"help.basic.edit.title" = "Sửa địa điểm";
"help.basic.edit.body" = "Nhấn vào một hàng trong danh sách để mở màn hình chi tiết, rồi nhấn nút 'Sửa' ở góc trên bên phải.";
"help.basic.delete.title" = "Xóa địa điểm";
"help.basic.delete.body" = "Vuốt sang trái trên một hàng trong danh sách để hiện nút 'Xóa'.";
"help.basic.search.title" = "Tìm kiếm địa điểm";
"help.basic.search.body" = "Kéo xuống màn hình danh sách để hiện thanh tìm kiếm. Tìm kiếm theo tiêu đề, tên sự kiện, ghi chú và danh mục.";
"help.bulk.multiDelete.title" = "Chọn và xóa nhiều mục";
"help.bulk.multiDelete.body" = "Vào '…' → 'Chọn' để vào chế độ chọn, nhấn vào các hàng cần xóa. Dùng 'Chọn tất cả' rồi nhấn biểu tượng thùng rác để xóa hàng loạt sau khi xác nhận.";
"help.bulk.share.title" = "Gửi nhiều mục sang thiết bị khác";
"help.bulk.share.body" = "Ở chế độ chọn, chọn các hàng và nhấn nút chia sẻ (↑) trên thanh công cụ. Chọn AirDrop hoặc điểm đến khác. Người nhận có thể nhập dữ liệu qua '…' → 'Nhập'.";
"help.detail.inline.title" = "Chỉnh sửa trực tiếp trên màn hình chi tiết";
"help.detail.inline.body" = "Nhấn giữ bất kỳ trường nào (tên, sự kiện, danh mục, ngày, đánh giá, ghi chú) trên màn hình chi tiết để chỉnh sửa trực tiếp. Nhấn 'Lưu' để xác nhận hoặc 'Hủy' để bỏ.";
"help.detail.go.title" = "Nút Go — Google Maps";
"help.detail.go.body" = "Với địa điểm có tọa độ, nút Go xuất hiện góc trên bên phải. Chọn điểm xuất phát để mở màn hình chỉ đường trong Google Maps. Chọn ô tô, đi bộ, phương tiện công cộng... trong ứng dụng. Nếu chưa cài ứng dụng, trình duyệt sẽ mở. Bạn cũng có thể mở cùng địa điểm qua 'Mở trong Google Maps' trên chi tiết và danh sách.";
"help.detail.mapJump.title" = "Nhảy sang tab Bản đồ từ chi tiết";
"help.detail.mapJump.body" = "Ảnh nền ở đầu màn hình chi tiết là ảnh chụp bản đồ. Nhấn 'Xem vị trí' trong mục Vị trí để chuyển sang tab Bản đồ và lấy địa điểm đó làm trung tâm.";
"help.filter.filter.title" = "Lọc";
"help.filter.filter.body" = "Nhấn biểu tượng lọc ở đầu danh sách để lọc theo danh mục và mức độ yêu thích, theo tháng (gộp theo năm) hoặc theo khoảng thời gian dựa trên ngày thăm hoặc ngày đăng ký. Biểu tượng hiện đặc khi bộ lọc đang hoạt động.";
"help.filter.sort.title" = "Sắp xếp";
"help.filter.sort.body" = "Dùng biểu tượng sắp xếp để chuyển tăng/giảm dần theo 'Tên địa điểm', 'Sự kiện', 'Ngày ghé thăm' hoặc 'Khoảng cách'. Sắp xếp theo khoảng cách yêu cầu quyền vị trí.";
"help.photo.add.title" = "Thêm hoặc đổi ảnh";
"help.photo.add.body" = "Trong mục Ảnh của màn hình thêm/sửa, nhấn 'Thêm ảnh' để chọn từ thư viện. Ảnh được nén tối đa 1200px khi lưu. Nhấn 'Xóa ảnh' để xóa.";
"help.photo.display.title" = "Ảnh & bản đồ trong danh sách và chi tiết";
"help.photo.display.body" = "Chỉ ảnh bạn thêm mới làm thumbnail; nếu không có ảnh thì có khung nhạt (chữ bên phải không bị lệch). Đầu màn chi tiết chỉ là bản đồ. Nếu có ảnh, hiển thị ở cuối (dưới 'Tìm bằng Google AI').";
"help.photo.exif.title" = "Tự động nhập vị trí & ngày thăm từ ảnh";
"help.photo.exif.body" = "Khi bạn chọn ảnh từ thư viện trong màn hình thêm/sửa, tọa độ GPS sẽ tự động điền nếu ảnh có dữ liệu vị trí. Ngày giờ chụp cũng được áp dụng vào ngày thăm nếu có. Thông báo sẽ hiện nếu không tìm thấy dữ liệu nào.";
"help.quickShoot.shoot.title" = "Ghi lại nhanh với Chụp nhanh";
"help.quickShoot.shoot.body" = "Nhấn nút Chụp ở giữa thanh tab để mở camera. Sau khi chụp, ảnh và vị trí (GPS hoặc vị trí hiện tại) tự động lưu thành bản nháp. Tiện dụng khi muốn ghi lại nhanh trong lúc di chuyển.";
"help.quickShoot.draft.title" = "Hoàn thiện bản nháp sau";
"help.quickShoot.draft.body" = "Bản nháp xuất hiện đầu danh sách với nhãn Bản nháp màu cam. Nhấn để mở màn hình sửa, thêm tiêu đề và danh mục, rồi nhấn Lưu chính thức để lưu thành bản ghi đầy đủ. Bạn cũng có thể xóa bản nháp bằng cách vuốt sang trái.";
"help.memo.view.title" = "Xem ghi chú (từ danh sách)";
"help.memo.view.body" = "Địa điểm có ghi chú sẽ hiển thị '📝' ở cuối hàng. Nhấn để xem ghi chú trong cửa sổ popup.";
"help.memo.edit.title" = "Sửa ghi chú (màn hình chi tiết)";
"help.memo.edit.body" = "Nhấn giữ ô Ghi chú trên màn hình chi tiết để vào chế độ chỉnh sửa. Nhấn 'Lưu' sau khi nhập xong.";
"help.mapLink.import.title" = "Nhập liên kết chia sẻ bản đồ";
"help.mapLink.import.body" = "Mở địa điểm trong Google Maps, rồi Chia sẻ → Sao chép liên kết. Dán vào ô 'Liên kết chia sẻ bản đồ' trong thêm/sửa để tự động điền tọa độ (hỗ trợ liên kết Google Maps như maps.app.goo.gl và các định dạng phổ biến khác).";
"help.mapLink.open.title" = "Mở Google Maps từ trong ứng dụng";
"help.mapLink.open.body" = "Nhập tên địa điểm trong thêm/sửa, rồi nhấn 'Mở Google Maps theo tên'. Tìm địa điểm, Chia sẻ → Sao chép liên kết, quay lại ứng dụng và liên kết sẽ tự động điền.";
"help.mapLink.slow.title" = "Nếu nhập liên kết mất nhiều thời gian";
"help.mapLink.slow.body" = "Liên kết rút gọn (maps.app.goo.gl) cần được mở rộng qua mạng, có thể mất vài giây. Khóa Places API giúp tăng độ tin cậy.";
"help.mapLink.list.title" = "Nhập danh sách đã lưu từ dịch vụ bản đồ";
"help.mapLink.list.body" = "Từ danh sách, dùng '…' → 'Nhập danh sách liên kết bản đồ' và dán URL chia sẻ, văn bản đã sao chép hoặc Google Takeout Saved Places JSON/CSV. Tên danh sách được lưu làm tên sự kiện trong osmStroll.";
"help.mapLink.export.title" = "Xuất danh sách liên kết Google Maps";
"help.mapLink.export.body" = "Chọn '…' → 'Xuất' → 'Danh sách liên kết Google Maps (TXT)' để xuất URL tìm kiếm google.com/maps cho các địa điểm. Làm theo hướng dẫn của từng ứng dụng khi sao chép sang danh sách khác.";
"help.mapTab.tab.title" = "Tab Bản đồ";
"help.mapTab.tab.body" = "Tab Bản đồ ở phía dưới màn hình hiển thị tất cả địa điểm đã lưu dưới dạng ghim. Nhấn vào ghim để đến màn hình chi tiết.";
"help.mapTab.switch.title" = "Chuyển sang tab Bản đồ từ chi tiết";
"help.mapTab.switch.body" = "Nhấn 'Xem vị trí' trong mục Vị trí trên màn hình chi tiết để tự động chuyển sang tab Bản đồ và lấy địa điểm đó làm trung tâm.";
"help.appearance.theme.title" = "Chủ đề màu";
"help.appearance.theme.body" = "Vào Cài đặt → Chủ đề màu để chọn trong 4 bảng màu: Chuẩn, Thanh lịch, Tươi sáng và Đơn sắc. Màu nhấn, màu sao và màu ghim bản đồ đều thay đổi cùng nhau.";
"help.appearance.style.title" = "Kiểu, họa tiết & màu nền";
"help.appearance.style.body" = "Vào Cài đặt → Giao diện để tùy chỉnh kiểu thẻ (Pastel, Neon...), họa tiết nền (Lưới, Chấm...) và màu nền ứng dụng. Cũng có thể tùy chỉnh màu sắc và kiểu khung riêng.";
"help.data.backup.title" = "Sao lưu dữ liệu";
"help.data.backup.body" = "Vào '…' → 'Xuất' để lưu tất cả địa điểm dưới dạng file JSON. Nên lưu vào iCloud Drive hoặc ứng dụng Files để an toàn.";
"help.data.restore.title" = "Khôi phục hoặc chuyển dữ liệu";
"help.data.restore.body" = "Vào '…' → 'Nhập' để tải file JSON/ZIP đã xuất. Nếu chọn văn bản hoặc CSV/JSON có URL chia sẻ bản đồ, ứng dụng sẽ thử nhập như danh sách liên kết.";
"help.plan.upgrade.title" = "Xem gói & Nâng cấp";
"help.plan.upgrade.body" = "Nhấn '…' → 'Gói cước' để xem gói hiện tại hoặc nâng cấp. Gói FREE cho phép tối đa 10 địa điểm. Nâng cấp lên PREMIUM để không giới hạn và thay đổi biểu tượng ứng dụng.";
"help.plan.restore.title" = "Khôi phục giao dịch mua";
"help.plan.restore.body" = "Sau khi đổi thiết bị hoặc cài lại ứng dụng, nhấn '…' → 'Gói cước' → 'Khôi phục mua hàng'. Nếu bạn đã mua PREMIUM bằng cùng Apple ID, gói sẽ được khôi phục.";
"help.settings.language.title" = "Đổi ngôn ngữ";
"help.settings.language.body" = "Vào Cài đặt → Ngôn ngữ để chuyển giữa Tiếng Nhật, English và Tiếng Việt.";
"help.settings.categories.title" = "Quản lý danh mục";
"help.settings.categories.body" = "Vào Cài đặt → Danh mục để thêm, xóa, sắp xếp lại hoặc đổi biểu tượng. Để sắp xếp, nhấn 'Sửa' rồi kéo các hàng.";
"help.apiKey.places.title" = "Về Places API Key";
"help.apiKey.places.body" = "Đăng ký khóa 'Places API (New)' từ Google Cloud Console giúp cải thiện độ chính xác khi phân tích tọa độ từ liên kết chia sẻ. Nhiều liên kết vẫn hoạt động không có khóa, nhưng khóa giúp giảm lỗi.";

// MARK: - Quick Shoot & Draft (Help)
"写真から位置・訪問日を自動取り込み" = "Tự động nhập vị trí & ngày thăm từ ảnh";
"追加・編集画面でカメラロールから写真を選ぶと、写真に GPS 情報が記録されていれば緯度・経度が自動で入力されます。撮影日時が記録されていれば訪問日時も自動で反映されます。どちらも含まれない場合はメッセージが表示されます。" = "Khi bạn chọn ảnh từ thư viện trong màn hình thêm/sửa, tọa độ GPS sẽ tự động điền nếu ảnh có dữ liệu vị trí. Ngày giờ chụp cũng được áp dụng vào ngày thăm nếu có. Thông báo sẽ hiện nếu không tìm thấy dữ liệu nào.";
